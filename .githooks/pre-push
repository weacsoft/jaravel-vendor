#!/bin/sh
# jaravel-vendor pre-push hook — version tag format guard.
#
# Policy: every version tag must be exactly x.y.z (e.g. 0.1.3).
# No leading "v", no pre-release/build suffix, no other decorations.
#
# Install (per clone):  git config core.hooksPath .githooks
#
# Only tags are checked; branch pushes pass through untouched.
# Tag deletions (newrev == 000...) are always allowed.

zero=0000000000000000000000000000000000000000
status=0

while read -r refname oldrev newrev; do
    [ "$newrev" = "$zero" ] && continue

    case "$refname" in
        refs/tags/*)
            tag=${refname#refs/tags/}
            if ! printf '%s' "$tag" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
                echo "pre-push: refusing tag '$tag' — version tags must be x.y.z (e.g. 0.1.3), without a 'v' prefix or any suffix." >&2
                status=1
            fi
            ;;
    esac
done

exit $status
