<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.lijialong1313</groupId>
        <artifactId>jaravel-vendor</artifactId>
        <version>0.1.2</version>
    </parent>

    <artifactId>wechat-sdk</artifactId>
    <name>wechat-sdk</name>
    <description>微信 SDK：公众号 / 小程序 API 访问，对齐 PHP overtrue/laravel-wechat（EasyWeChat）</description>

    <dependencies>
        <!-- 内部模块：缓存（AccessToken / jsapi_ticket 缓存基础，提供 CacheManager/CacheStore） -->
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>cache</artifactId>
        </dependency>
        <!-- 内部模块：core（PublishableConfig 静态注册） -->
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <!-- 内部模块：utils（SimpleMemoryCache fallback 基础设施，CacheManager.createDefaultStore() 依赖） -->
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>utils</artifactId>
        </dependency>
        <!-- 内部模块：http（Laravel 风格 Request/Response、Middleware 洋葱模型、SessionStore 会话契约；
             OAuth 网页授权中间件 WeChatOAuthMiddleware 与 Request.fullUrl() 依赖本模块） -->
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>http</artifactId>
        </dependency>
        <!-- OkHttp：所有微信 API HTTP 调用 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
        </dependency>
        <!-- Jackson：JSON 解析（Spring Boot 已管理版本） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- SLF4J 日志门面 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Servlet API（仅测试：WeChatOAuthMiddleware 用 Mockito 模拟 HttpServletRequest 驱动 Request.fullUrl()） -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>

