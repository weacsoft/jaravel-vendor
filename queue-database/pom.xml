<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.lijialong1313</groupId>
        <artifactId>jaravel-vendor</artifactId>
        <version>0.1.3</version>
    </parent>

    <artifactId>queue-database</artifactId>
    <name>queue-database</name>
    <description>数据库队列驱动：持久化任务存储 / 多实例消费 / 重试机制，对齐 Laravel database queue driver</description>

    <dependencies>
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>event</artifactId>
        </dependency>
        <!-- D3（Spring 解耦终收，经用户确认执行）：原 spring-jdbc + spring-context 编译依赖已移除——
             · DatabaseQueueDispatcher / DatabaseQueueWorker 改经 core.lookup.BeanLookup SPI 解析监听器 bean
             · Spring 宿主接线（DatabaseQueueDriver 装配 / ContextBeanProvider 适配）位于 springboot 模块
               vendor.springboot.queuedatabase，运行期 Spring 依赖由宿主提供 -->
        <!-- 0.1.3 架构对齐：SQL 执行统一使用 database 模块 JdbcExecutor（不再自带私有 JDBC 四件套），
             建表统一走 migration 模块 Schema（不再手拼 CREATE TABLE IF NOT EXISTS） -->
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>database</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- redis 驱动按需依赖：未引入 redis 时自动回退到 database 驱动 -->
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>redis</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Artisan CLI 集成（optional：仅 SpringBoot 环境下注册 queue:table 命令） -->
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>artisan</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 迁移文件生成（optional：queue:table 命令生成迁移文件时使用） -->
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>migration</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试依赖（测试态允许 Spring 工具；main 代码零 Spring） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>

