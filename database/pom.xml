<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.lijialong1313</groupId>
        <artifactId>jaravel-vendor</artifactId>
        <version>0.1.3</version>
    </parent>

    <artifactId>database</artifactId>
    <name>database</name>
    <description>数据库：gaarason/database-core 集成、BaseModel、EloquentUserProvider（手动 @Bean 创建 GaarasonDataSource）</description>

    <dependencies>
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>auth</artifactId>
        </dependency>

        <!-- Laravel 风格 ORM 核心（不含 SpringBoot 自动配置，需手动 @Bean 创建 GaarasonDataSource） -->
        <!-- database-query 依赖 database-core，提供 QueryBuilder；database-core 依赖 druid -->
        <dependency>
            <groupId>io.github.gaarason</groupId>
            <artifactId>database-query</artifactId>
        </dependency>

        <!-- gaarason/database 的 JsonConversion 需要 jsr310（LocalDateTimeSerializer） -->
        <!-- SB3 由 starter-json 传递；SB4 切换至 Jackson 3 不再传递，需显式提供，与 Jackson 2.18.2 对齐 -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- Druid 数据源，用于手动创建 GaarasonDataSource -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid</artifactId>
        </dependency>

        <!-- D2（Spring 解耦）：原 spring-boot-starter-jdbc / spring-boot-starter-aop 编译依赖已移除——
             本模块源码零 Spring import。Spring 宿主侧装配（DatabaseAutoConfiguration /
             EloquentUserProviderAutoConfiguration / ModelShadowPatcher / EloquentUserProviderDriver /
             BaseModel 数据源绑定 BPP）位于 jaravel-springboot 模块 vendor.springboot.database 包；
             gaarason 运行期所需的 Spring JDBC/AOP 由宿主（springboot/starter）提供。 -->

        <!-- 测试依赖（spring-boot-starter-test 携带 spring-test / spring-context，
             供测试态 ApplicationContext 适配使用） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>

