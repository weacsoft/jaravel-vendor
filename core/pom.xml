<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.lijialong1313</groupId>
        <artifactId>jaravel-vendor</artifactId>
        <version>0.1.2</version>
    </parent>

    <artifactId>core</artifactId>
    <name>core</name>
    <description>核心：Facades 门面 / Config 配置仓库 / ServiceProvider / Validation 校验 / Str·Arr 工具（P3 起零 Spring 依赖）</description>

    <dependencies>
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>json</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- 测试依赖 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                P3（Spring 解耦）：core 模块零 Spring 依赖。
                遗留文件 core/autoconfigure/CoreAutoConfiguration.java 因文件系统权限限制
                （ACL 仅 BUILTIN\\Users 只读，无法删除/改写）暂留于源码树，
                故在此将其排除出编译（内容已由 springboot 模块的
                com.weacsoft.jaravel.vendor.springboot.core.CoreSpringConfiguration 完全接管）；
                待用户以更高权限删除该文件及下方 core 的 imports 资源文件后可移除本配置。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/autoconfigure/CoreAutoConfiguration.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!--
                P3：core 的 AutoConfiguration.imports 资源文件同为 ACL 锁定遗留，
                其唯一条目指向上述不再编译的类。打包时排除该资源文件，
                避免下游 Spring Boot 应用加载不存在的自动配置类。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>META-INF/spring/org.springframework.boot.autoconfigure.AutoConfiguration.imports</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
