<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.lijialong1313</groupId>
        <artifactId>jaravel-vendor</artifactId>
        <version>0.1.3</version>
    </parent>

    <artifactId>cache-database</artifactId>
    <name>cache-database</name>
    <description>数据库缓存驱动：JDBC 持久化 / 方言适配 / cache:table 命令，走 database 模块连接，不依赖 Spring JDBC（对齐 queue-database 拆分惯例）</description>

    <dependencies>
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>cache</artifactId>
        </dependency>
        <!-- 数据库连接直接走 database 模块（ConnectionManager 连接注册表），不再依赖 spring-jdbc -->
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>database</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- Artisan CLI 集成（optional：仅 SpringBoot 环境下注册 cache:table 命令） -->
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>artisan</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 迁移文件生成（optional：cache:table 命令生成迁移文件时使用） -->
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>migration</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
